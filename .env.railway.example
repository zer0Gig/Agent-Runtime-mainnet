# ── Railway Environment Variables — MAINNET (Aristotle, chain 16661) ─────
# Set these in Railway Dashboard → Variables (copy-paste each key)
# ⚠️ NEVER commit this file with real values to git
# ⚠️ All deposits below are REAL OG — adjust amounts accordingly

# ── 0G Network ───────────────────────────────────────
# Canonical name. Code prefers OG_RPC_URL, falls back to OG_NEWTON_RPC for
# backwards compatibility with the testnet codebase.
OG_RPC_URL=https://evmrpc.0g.ai
OG_NEWTON_RPC=https://evmrpc.0g.ai
CHAIN_ID=16661

# ── Agent Wallet ─────────────────────────────────────
# Private key WITHOUT 0x prefix (single-agent Path A fallback)
# ⚠️ MAINNET KEY — never reuse the testnet wallet
AGENT_PRIVATE_KEY=your_mainnet_agent_private_key_without_0x
AGENT_ID=1

# ── ECIES Keypair (per-agent encryption) ─────────────
AGENT_ECIES_PRIVATE_KEY=your_ecies_private_key_hex
AGENT_ECIES_PUBLIC_KEY=your_ecies_public_key_hex

# ── Contract Addresses (Aristotle mainnet — deployed 2026-05-16) ──
# Scan links: https://chainscan.0g.ai/address/<address>
AGENT_REGISTRY_ADDRESS=0x0fAE6342195fdc0007B94Fb3293bF56463C55ff3
PROGRESSIVE_ESCROW_ADDRESS=0x5A18F8D33D551666233701025754274dCA9B2929
SUBSCRIPTION_ESCROW_ADDRESS=0x7A072465AC232709C114C5DAa842a9b7010D1d4f
USER_REGISTRY_ADDRESS=0x10421Eb1A230F484eEdB64642505d073e791823c
AGENT_MARKETPLACE_ADDRESS=0x3D33c7E30c9FC1AE387387dabb5a8fcc3333d83e
AGENT_EARNINGS_VAULT_ADDRESS=0x38f22fe2fF8f2e0bF346D2889a276c1b872B6880

# ── 0G Storage ──────────────────────────────────────
# Mainnet indexer (turbo, no `-testnet` suffix)
OG_INDEXER_RPC=https://indexer-storage-turbo.0g.ai
# Storage layer uses the chain RPC for Flow contract submissions.
OG_STORAGE_RPC=https://evmrpc.0g.ai
# Mainnet Flow contract — required for Batcher KV writes. Source:
# https://docs.0g.ai/developer-hub/mainnet/mainnet-overview
OG_FLOW_ADDRESS=0x62D4144dB0F0a6fBBaeb6296c785C71B3D57C526

# ── 0G Compute Network ────────────────────────────────
# LedgerManager on mainnet (confirmed by Jiahao, 0G team):
#   0x2dE54c845Cd948B72D2e32e39586fe89607074E3
# SDK reads chain id from wallet RPC and routes to the correct LedgerManager,
# so no explicit address env var is needed — but keep this comment for ops.
#
# ⚠️ Real OG amounts. Mainnet minimums per Jiahao:
#   Ledger: 3 OG minimum
#   Provider sub-account: 1 OG minimum
# Tune downward for tighter unit economics if a Foundation-owned provider
# accepts smaller deposits.
OG_COMPUTE_LEDGER_DEPOSIT=3
OG_COMPUTE_PROVIDER_DEPOSIT=1

# ── 0G Alignment Node Verification ───────────────────
# Deployer wallet private key (for demo self-signing)
ALIGNMENT_VERIFIER_KEY=your_mainnet_deployer_private_key

# ── Platform Dispatcher (Path B) ─────────────────────
# Required when running `npm run start:platform` (which railway.toml uses)
PLATFORM_PRIVATE_KEY=your_mainnet_platform_operator_private_key
PLATFORM_AGENT_IDS=2

# Per-agent signer keys for releaseMilestone. Format: "agentId:privKey,agentId:privKey"
AGENT_WALLET_KEYS=2:your_mainnet_agent_2_private_key

# ── Demo / Alignment Configuration ───────────────────
# ⚠️ DEMO MODE on mainnet is NOT recommended — real funds at stake.
# For mainnet, set to false and rely on alignment scores.
AUTO_APPROVE_MILESTONES=false

# Alignment auto-release threshold (basis points: 7500 = 75%).
ALIGNMENT_AUTO_APPROVE_THRESHOLD=7500
ALIGNMENT_GRACE_PERIOD_MS=60000

# Alignment score for demo mode (must be >= 8000) — only used if AUTO_APPROVE_MILESTONES=true
DEMO_ALIGNMENT_SCORE=8500

# ── LLM Provider ─────────────────────────────────────
# Options:
#   0g-router    — RECOMMENDED for mainnet. Uses pc.0g.ai unified API key,
#                  auto-routes to 0GM-1.0-35B-A3B (0G-native, agentic) and
#                  deepseek-v4-pro. No per-provider sub-account dance.
#   0g-compute   — Direct per-provider SDK flow (wallet-signed, decentralized).
#                  Requires 3 OG ledger + 1 OG per provider (refundable in 24h).
#   groq         — Cheapest fallback for chat (no OG required)
#   openai/anthropic/google/alibaba/openrouter — paid external providers
FALLBACK_LLM_PROVIDER=0g-router

# ── 0G Router Mode (pc.0g.ai) ────────────────────────
# Get an app-sk-XXX API key from https://pc.0g.ai/sdk/dashboard
# Deposit 0G via the dashboard once; routes pay-per-request without locking
# funds in per-provider sub-accounts.
OG_ROUTER_API_KEY=app-sk-your-router-api-key
# Default model — override per-call via chatCompletion({ model }) if needed.
#   "0GM-1.0-35B-A3B"          — 0G's own model (35B MoE, agentic coding, cheap)
#   "deepseek-v4-pro"           — strongest reasoning (1.6T MoE, 1M context)
#   "GLM-5-FP8"                 — #1 open-source LLM
#   "deepseek-chat-v3-0324"     — fast conversational
OG_ROUTER_MODEL=0GM-1.0-35B-A3B

# ── LLM API Keys ─────────────────────────────────────
GROQ_API_KEY=your_groq_api_key
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
GOOGLE_API_KEY=your_google_api_key
ALIBABA_API_KEY=your_alibaba_api_key
OPENROUTER_API_KEY=your_openrouter_api_key

# ── Supabase (Skills Registry + Bot Config) ──────────
# Same Supabase project as testnet — schema is chain-agnostic. Use a separate
# `network` column or table-prefix if you want to keep mainnet rows isolated.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Frontend Integration ──────────────────────────────
# URL of your deployed mainnet Vercel frontend (separate deployment from testnet)
ACTIVITY_LOG_URL=https://your-mainnet-frontend.vercel.app/api/agent-activity
FRONTEND_URL=https://your-mainnet-frontend.vercel.app

# ── Auth Token (agent ↔ frontend) ────────────────────
# Generate with: openssl rand -hex 32
# Set the SAME value in frontend env vars
AGENT_RUNTIME_TOKEN=your_random_hex_token

# ── ECIES Platform Encryption ────────────────────────
# Run `node src/setup-encryption-keys.js` locally to generate.
PLATFORM_ENCRYPTION_PRIVATE_KEY=your_platform_ecies_private_key

# ── Telegram Bot (optional) ──────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_WEBHOOK_URL=https://your-mainnet-railway-url.railway.app
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_token

# ── 0G KV Node (optional — local only) ──────────────
OG_KV_NODE_RPC=http://localhost:6789
