# ── 0G Network (Aristotle Mainnet, chain 16661) ──────
# Canonical name. OG_NEWTON_RPC kept as a backwards-compatible alias for
# scripts that haven't migrated yet.
OG_RPC_URL=https://evmrpc.0g.ai
OG_NEWTON_RPC=https://evmrpc.0g.ai
CHAIN_ID=16661

# ── Agent Wallet (DO NOT commit private keys!) ──────
AGENT_PRIVATE_KEY=your_agent_wallet_private_key_without_0x
AGENT_ID=1

# ── ECIES Keypair (for encrypted job briefs) ────────
AGENT_ECIES_PRIVATE_KEY=your_ecies_private_key_hex
AGENT_ECIES_PUBLIC_KEY=your_ecies_public_key_hex

# ── Contract Addresses (Aristotle mainnet — deployed 2026-05-16) ──
AGENT_REGISTRY_ADDRESS=0x0fAE6342195fdc0007B94Fb3293bF56463C55ff3
PROGRESSIVE_ESCROW_ADDRESS=0x5A18F8D33D551666233701025754274dCA9B2929
SUBSCRIPTION_ESCROW_ADDRESS=0x7A072465AC232709C114C5DAa842a9b7010D1d4f
USER_REGISTRY_ADDRESS=0x10421Eb1A230F484eEdB64642505d073e791823c
AGENT_MARKETPLACE_ADDRESS=0x3D33c7E30c9FC1AE387387dabb5a8fcc3333d83e
AGENT_EARNINGS_VAULT_ADDRESS=0x38f22fe2fF8f2e0bF346D2889a276c1b872B6880

# ── 0G Storage (Aristotle mainnet) ──────────────────
OG_STORAGE_RPC=https://evmrpc.0g.ai
OG_INDEXER_RPC=https://indexer-storage-turbo.0g.ai
# Mainnet Flow contract (used by Batcher.exec for KV writes):
OG_FLOW_ADDRESS=0x62D4144dB0F0a6fBBaeb6296c785C71B3D57C526

# ── 0G KV Node (Option B — persistent cross-restart KV layer) ──────
# Enables the CustomerServiceBot and memoryService to remember conversations
# and learnings across process restarts. If unreachable, runtime falls back
# to in-memory Map (circuit breaker opens after 2 timeouts for 5 min).
#
# IMPORTANT: 0G does NOT host a public KV Node for testnet. The IP below
# (3.101.147.150) is a dead AWS instance from the outdated docs.
# To get real cross-restart memory, run a local KV node:
#   See Project/kv-node/README.md for WSL setup (5 minutes)
# Then set:
#   OG_KV_NODE_RPC=http://localhost:6789
OG_KV_NODE_RPC=http://localhost:6789
# Optional: override the Flow contract address used for KV writes.
# If not set, resolved automatically from the first selected storage node.
# OG_FLOW_ADDRESS=0x...

# ── 0G Alignment Node Verification ──────────────────
# For demo: use deployer private key to self-sign alignment scores
# In production: 0G Alignment Nodes sign evaluation results
ALIGNMENT_VERIFIER_KEY=your_deployer_private_key

# ── Platform Dispatcher (multi-agent) ─────────────────
# Per-agent signer keys for releaseMilestone. Each key must match the agentWallet
# passed to mintAgent() for that agentId. Format: "agentId:privKey,..."
# Falls back to AGENT_PRIVATE_KEY when not set (single-agent only).
AGENT_WALLET_KEYS=

# DEMO ONLY — bypasses every approval gate. Use for hackathon E2E testing.
# Production should leave this false and rely on ALIGNMENT_AUTO_APPROVE_THRESHOLD.
AUTO_APPROVE_MILESTONES=false

# Alignment Node auto-release threshold (production path).
# When the agent's self-eval score >= this value AND the alignment digest is
# signed by PLATFORM_PRIVATE_KEY (the configured alignmentNodeVerifier),
# the runtime auto-releases after a brief grace window. The client can override
# during the grace window by sending any chat message.
# Score is in basis points (0–10000). 7500 = 75%. Set 10001 to disable.
ALIGNMENT_AUTO_APPROVE_THRESHOLD=7500
ALIGNMENT_GRACE_PERIOD_MS=60000

# ── 0G Compute Network ─────────────────────────────
# SDK v0.6.x enforces hard minimums:
#   addLedger:    3 OG minimum  (first-time ledger creation)
#   transferFund: 1 OG minimum  (per provider)
# Total: fund agent wallet with at least 4 OG. ⚠️ NO MAINNET FAUCET — buy
# OG on a CEX (Binance / KuCoin) and withdraw to your mainnet agent wallet.
# If ledger deposit < 3, runtime auto-routes to FALLBACK_LLM_PROVIDER.
OG_COMPUTE_LEDGER_DEPOSIT=3
OG_COMPUTE_PROVIDER_DEPOSIT=1

# Provider addresses (mainnet):
# Recommend Router Mode at https://pc.0g.ai — unified account across all
# Foundation-owned models. Per-provider sub-accounts also work but each
# needs its own transferFund and 24h refund flow.
# Avoid external (non-Foundation) providers — flagged unstable by 0G team.

# ── Primary LLM Provider for agents ────────────────
# Options (mainnet-aware):
#   0g-router    ⭐ Recommended — pc.0g.ai unified API, auto-routes to 0GM-1.0
#                  (0G-native, agentic coding) and DeepSeek V4 Pro. Single
#                  app-sk-XXX key, no per-provider fund management.
#   0g-compute   Direct per-provider SDK (wallet-signed, requires 4 OG locked)
#   groq         Cheapest fallback, no OG needed
#   openai/anthropic/google/alibaba/openrouter — paid external providers
FALLBACK_LLM_PROVIDER=0g-router

# ── 0G Router Mode (recommended for mainnet) ──────
# Get app-sk-XXX from https://pc.0g.ai/sdk/dashboard
OG_ROUTER_API_KEY=app-sk-your-router-api-key
OG_ROUTER_MODEL=0GM-1.0-35B-A3B

# API Keys for Standardized Providers
OPENAI_API_KEY=sk-your-openai-key
OPENROUTER_API_KEY=sk-or-your-openrouter-key
ALIBABA_API_KEY=sk-your-alibaba-key
GOOGLE_API_KEY=sk-your-google-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
GROQ_API_KEY=gsk-your-groq-key

# ── Supabase (Skills Registry) ───────────────────────
# Same project URL/key as your frontend .env.local
# Required for pre-built skill resolution (F2 Skills Registry)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Service role key — required for Customer Service Bot (reads client_bot_configs which has RLS).
# Get from: Supabase Dashboard → Project Settings → API → service_role secret (the long eyJ... key)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Agent Activity Log (Frontend API URL) ────────────
# Set this to your deployed frontend URL so the agent can report progress to the UI
ACTIVITY_LOG_URL=http://localhost:3000/api/agent-activity

# ── Live Chat (Frontend integration) ─────────────────
# URL of the deployed frontend, used to POST chat messages to /api/job-chat
FRONTEND_URL=http://localhost:3000

# Optional auth token for securing the chat API endpoint.
# Generate a random string (e.g. `openssl rand -hex 32`) and set the same value
# in both the frontend and agent runtime. Leave blank to disable auth in dev.
AGENT_RUNTIME_TOKEN=

# ── Skill-config encryption (ECIES) ──────────────────
# Run `node src/setup-encryption-keys.js` once per environment to generate this
# pair. Frontend gets the public key; runtime keeps the private key.
# Without it, runtime falls back to plaintext skill configs and logs a warning.
PLATFORM_ENCRYPTION_PRIVATE_KEY=

# ── Telegram Bot (optional — enables milestone notifications via Telegram) ──
# 1. Open Telegram → message @BotFather → /newbot → follow prompts → copy token
# 2. Paste token below
# 3. When a client connects their Telegram (via deep link), milestone cards will
#    be sent directly to their Telegram with Approve / Request Changes buttons.
# Leave blank to disable Telegram (dashboard chat still works).
TELEGRAM_BOT_TOKEN=
# Production deployment — set both. Webhook activates when URL is set; secret is optional but
# strongly recommended (Telegram sends it as X-Telegram-Bot-Api-Secret-Token header).
# TELEGRAM_WEBHOOK_URL=https://your-deployed-domain.com
# TELEGRAM_WEBHOOK_SECRET=any-long-random-string-32-chars-min
